{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/index.js?__p=$1"
    },
    {
      "src": "/p/([A-Za-z0-9]+)/?",
      "dest": "/index.js?__p=p/$1"
    },
    {
      "src": "/(index\\.html)?",
      "dest": "/index.html",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Cache-Control": "no-cache"
      }
    }
  ]
}